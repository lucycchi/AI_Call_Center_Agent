{"case_id": "T7d8fb3e5", "attempt": 1, "handed_off": false, "clean_decline": false, "all_correct": null, "first_route": "scheduling", "grades": {}, "conversation": [{"role": "caller", "text": "I need to file a warranty claim. The unit you installed last year stopped working."}, {"role": "agent", "text": "To file a warranty claim, call to schedule a warranty diagnostic."}, {"role": "agent", "text": "If the failure is covered, there is no diagnostic fee, but if the technician determines it is not covered, the standard $89 diagnostic fee applies (Warranty Policy, Filing a claim)."}, {"role": "agent", "text": "Since the unit was installed last year, it falls within the 2-year labor warranty that Meridian provides on all full system installations."}, {"role": "agent", "text": "Comfort Club members at the time of installation receive an extended 5-year labor warranty instead (Warranty Policy, New system installation warranty)."}, {"role": "agent", "text": "Manufacturer parts warranties are separate and vary by brand."}, {"role": "agent", "text": "Meridian registers every installed unit with the manufacturer within 30 days of install, and registration is required for the full parts warranty term."}, {"role": "agent", "text": "Manufacturer warranties cover the part only (Warranty Policy, Manufacturer parts warranty)."}, {"role": "agent", "text": "If you tell me the brand of your unit, I can give you the parts warranty terms for it."}, {"role": "agent", "text": "To look into your account and the installation, I need your full name and one of the following: your account number, the service address, or the phone number on the account."}, {"role": "caller", "text": "Sure, it's Grace Garcia, 512-686-4786."}, {"role": "agent", "text": "Thank you, Grace."}], "done_events": [{"route": "scheduling", "ticket": null, "receipt": {"safety": "clear", "clear": true, "sources": ["warranty/warranty_policy.md", "faq/troubleshooting_before_you_call.md"], "passages": ["warranty/warranty_policy