# Copy this file to .env and fill in the keys. Never commit .env.

# --- API keys ---
# Anthropic: runs the agent's conversation and sorts transcripts by call reason.
# Separate key for paid test runs; the test code never falls back to the live key.
EVAL_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI: optional. Grading and ground-truth labeling normally run through Codex (your subscription);
# this key is only the fallback if you choose to grade through the API instead.
OPENAI_API_KEY=
# Voyage AI: turns documents and questions into embeddings for document search (free allowance).
VOYAGE_API_KEY=

# --- Models ---
# Model IDs are pinned in app/config.py (router claude-haiku-5-5, writer claude-sonnet-5-5) and cannot be changed here.
# How test answers are graded: "codex" (default, no API cost) or "api" (uses OPENAI_API_KEY).
GRADER_BACKEND=codex
# Only used when GRADER_BACKEND=api; chosen during the spec stage.
GRADER_MODEL=
# Voyage embedding model; chosen during the spec stage.
EMBEDDING_MODEL=

# --- Limits ---
# Daily AI spending limits in US dollars. When a limit is reached, the agent hands off instead of answering.
# The author is alerted when site spending passes SPEND_ALERT_USD.
SITE_DAILY_USD=10
PER_VISITOR_DAILY_USD=0.40
REVIEWER_DAILY_USD=3
SPEND_ALERT_USD=5

# --- Data ---
# The live scheduling database. Never point this at the read-only seed file in call_data/; the app refuses to start if you do.
# ("Today" is fixed at 2026-10-16 09:00 Austin time in app/config.py.)
DATABASE_PATH=data/scheduling.sqlite

# --- Optional, for voice later ---
ELEVENLABS_API_KEY=

# Signs the visitor cookie (at least 16 random characters; set as a Fly.io secret in production)
VISITOR_COOKIE_SECRET=

# The secret reviewer link is https://<app>/#r=<token>; it is reusable (D50): every browser that opens it gets a
# 7-day reviewer session, and all of them draw on the shared reviewer reserve.
# Set a long random value as a Fly.io secret; never put the real value here.
REVIEWER_TOKEN=

# The shared staff password, stored only as a hash (pbkdf2_sha256$<iterations>$<salt>$<hash>). Make it with
# `python -m app.web.staff` and set it as a Fly.io secret; never put the password itself anywhere.
STAFF_PASSWORD_HASH=

# Where alerts go (error bursts, failed database writes, a failed nightly reset, daily spend passing SPEND_ALERT_USD):
# a webhook URL that accepts a JSON POST, such as a Slack or Discord incoming webhook. Empty sends no alerts.
# Set it as a Fly.io secret in production.
ALERT_WEBHOOK_URL=

# Site-only Anthropic key for the deployed site (D50): made in its own Anthropic console workspace with a $25/month
# spend limit. Set on Fly.io as ANTHROPIC_API_KEY; never used by test runs or local development.
SITE_ANTHROPIC_API_KEY=
